rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth != null;}
    function isAdmin(){return signedIn() && request.auth.token.admin == true;}
    function own(uid){return signedIn() && request.auth.uid == uid;}
    match /users/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']));
      match /transactions/{id} { allow read, write: if own(uid) || isAdmin(); }
      match /goals/{id} { allow read, write: if own(uid) || isAdmin(); }
    }
  }
}
